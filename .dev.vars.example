# Local development values for `npx wrangler dev`.
#
# Copy to `.dev.vars` (gitignored) — these are intentionally fake, public
# values; production secrets go in via `wrangler secret put` (see docs/setup.md).
PAYLOAD_KEK="dev-kek"
CONTENT_HMAC_KEY="dev-hmac"
MCP_READ_TOKEN="dev-read"
MCP_PROPOSE_TOKEN="dev-propose"
ADMIN_TOKEN="dev-admin"
GEMINI_API_KEY="dev-gemini"
AI_GATEWAY_BASE="https://gw.test/google-ai-studio"

# Optional — run chat and/or embeddings on any OpenAI-compatible provider.
# Unset = Gemini via the gateway above. See README → The envs.
#AI_BASE_URL="https://api.openai.com/v1"
#AI_API_KEY="sk-..."              # falls back to GEMINI_API_KEY; keyless works
#AI_MODEL="gpt-4.1-mini"          # required when AI_BASE_URL is set
#AI_FALLBACK_MODEL="gpt-4.1-mini"
#AI_EMBED_BASE_URL="https://api.openai.com/v1"   # or "native" for Gemini embeddings
#AI_EMBED_API_KEY="sk-..."
#AI_EMBED_MODEL="text-embedding-3-small"
#AI_EMBED_DIMS="768"              # must match your Vectorize index
