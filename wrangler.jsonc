{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Without keep_vars, `wrangler deploy` treats this file as the source of truth and
  // removes plain-text vars that were added in the Cloudflare dashboard. Secrets
  // (encrypted) are never touched by deploys either way.
  "keep_vars": true,

  // Fail deploy loudly if a required secret is missing on the Worker, instead of
  // silently shipping a worker whose endpoints all reject requests. Default-minimal
  // setup = three: the KEK (encryption), one admin token (auth), the model key.
  // The other three are optional hardening: CONTENT_HMAC_KEY (else derived from
  // the KEK), MCP_READ_TOKEN / MCP_PROPOSE_TOKEN (else the admin token is the
  // only credential — set them to give clients scoped-down access).
  "secrets": {
    "required": ["PAYLOAD_KEK", "ADMIN_TOKEN", "GEMINI_API_KEY"]
  },

  // Id-less on purpose: on a fresh account the deploy auto-provisions `brain-db`
  // (and `brain-raw` below) under these exact names; on existing accounts the
  // binding re-links by name. A `database_id` would pin the owner's account, so
  // forks must never carry one.
  "d1_databases": [{ "binding": "BRAIN_DB", "database_name": "brain-db" }],
  "r2_buckets": [{ "binding": "BRAIN_RAW", "bucket_name": "brain-raw" }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "brain-memory" }],
  // AI_GATEWAY_BASE is optional (unset = Gemini calls go straight to Google).
  // Set it in the dashboard (Settings → Variables and Secrets) to route through
  // your AI Gateway. Unlike D1/R2, a missing Vectorize binding fails the deploy
  // (error 10159) — scripts/ensure-vectorize.mjs, chained into `npm run deploy`,
  // creates the index + metadata indexes first.
  // Four of the five free cron slots: 30-min sweep, nightly consolidation,
  // weekly reflection (Mon 04:00), monthly reflection (1st 04:00).
  "triggers": { "crons": ["*/30 * * * *", "0 3 * * *", "0 4 * * 1", "0 4 1 * *"] },
  "observability": { "enabled": true },

  // Environments do NOT inherit bindings (d1_databases, r2_buckets, secrets, ...) from the
  // top level. The live worker is deployed from the top-level config: use
  // `wrangler deploy --env=""` — never `wrangler deploy --env prod` (that yields a
  // worker with zero bindings). The staging/prod blocks are stubs for future work.
  "env": {
    "staging": { "name": "brain-api-staging" },
    "prod": { "name": "brain-api" }
  }
}
