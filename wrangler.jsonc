{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brain-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Without keep_vars, `wrangler deploy` treats this file as the source of truth and
  // removes plain-text vars that were added in the Cloudflare dashboard. Secrets
  // (encrypted) are never touched by deploys either way.
  "keep_vars": true,

  // Fail deploy loudly if any required secret is missing on the Worker, instead of
  // silently shipping a worker whose endpoints all reject requests.
  "secrets": {
    "required": ["PAYLOAD_KEK", "CONTENT_HMAC_KEY", "MCP_READ_TOKEN", "MCP_PROPOSE_TOKEN", "ADMIN_TOKEN", "GEMINI_API_KEY"]
  },

  "d1_databases": [{ "binding": "BRAIN_DB", "database_name": "brain-db", "database_id": "4d7130e8-65aa-4558-985e-96d38db38b30" }],
  "r2_buckets": [{ "binding": "BRAIN_RAW", "bucket_name": "brain-raw" }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "brain-memory" }],
  // Gemini extraction/embeddings travel through AI Gateway; the provider key stays
  // in the GEMINI_API_KEY secret (pass-through x-goog-api-key). The account id in
  // the URL is already public in the README CI section.
  "vars": {
    "AI_GATEWAY_BASE": "https://gateway.ai.cloudflare.com/v1/1ce49401e2d9c63449f7621e4f5e10e9/brain/google-ai-studio"
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": true },

  // Environments do NOT inherit bindings (d1_databases, r2_buckets, secrets, ...) from the
  // top level. The live worker is deployed from the top-level config: use
  // `wrangler deploy --env=""` — never `wrangler deploy --env prod` (that yields a
  // worker with zero bindings). The staging/prod blocks are stubs for future work.
  "env": {
    "staging": { "name": "brain-api-staging" },
    "prod": { "name": "brain-api" }
  }
}
